@collector.command("/admin_export_group", visible=False)
async def admin_export_group_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    if not await check_auth(user_huid, bot): return

    USER_STATES[user_huid]["state"] = "WAIT_FOR_ADMIN_GROUP_NAME"
    
    markup = BubbleMarkup()
    markup.add_button(command="/cancel_admin_export", label="Отмена")
    
    await bot.answer_message(
        body="Введите точное название AD-группы для выгрузки (поиск по всему банку):",
        bubbles=markup
    )
