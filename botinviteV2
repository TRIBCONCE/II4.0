async def send_raw_message_with_file(chat_id: str, body: str, file_name: str, file_bytes: bytes):
    """Надежная функция для отправки файла от лица бота через прямой Event API eXpress"""
    import uuid
    import base64
    
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)

    b64_content = base64.b64encode(file_bytes).decode('utf-8')
    data_uri = f"data:text/csv;base64,{b64_content}"

    # Правильная структура payload для отправки сообщений от бота (Event API)
    payload = {
        "bot_id": bot_id_str,
        "events": [
            {
                "sync_id": str(uuid.uuid4()),
                "type": "command",
                "group_chat_id": chat_id,
                "command": {
                    "body": body,
                    "command_type": "user"
                },
                "attachments": [
                    {
                        "type": "document",
                        "data": {
                            "file_name": file_name,
                            "content": data_uri
                        }
                    }
                ]
            }
        ]
    }
    
    async with httpx.AsyncClient(timeout=30.0) as client:
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        
        # Перебираем правильные адреса для бот-ивентов
        urls_to_try = [
            f"{cts_url}/api/v3/botx/events",
            f"{cts_url}/api/v2/botx/events",
            f"{cts_url}/api/v4/botx/events"
        ]
        
        errors = []
        for url in urls_to_try:
            try:
                resp = await client.post(url, headers=headers, json=payload)
                # Если ответ не 404 (Page Not Found) и не 405 (Method Not Allowed), значит мы попали куда надо
                if resp.status_code not in (404, 405):
                    resp.raise_for_status()
                    return # Успешно отправили!
                errors.append(f"{url} -> {resp.status_code}")
            except Exception as e:
                errors.append(f"{url} -> {e}")
                
        raise Exception(f"Не удалось найти эндпоинт отправки. Ошибки: {errors}")