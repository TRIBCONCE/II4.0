async def add_members_to_chat_batch(chat_id: str, huids: list) -> tuple:
    """Добавляет пользователей пачками по 500. Умный поиск эндпоинта."""
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)
    
    success_count = 0
    error_count = 0
    error_details = []
    chunk_size = 500

    # В разных версиях eXpress эндпоинт добавления менялся. 
    # Функция сама найдет рабочий URL из этого списка:
    endpoints = [
        f"{cts_url}/api/v2/botx/chats/members",           # Чаще всего для добавления оставлен v2
        f"{cts_url}/api/v4/botx/chats/members",           # В новейших версиях перенесли в v4
        f"{cts_url}/api/v3/botx/chats/{chat_id}/members", # REST-формат
        f"{cts_url}/api/v3/botx/chats/add_members"        # Редкий RPC-формат
    ]

    working_url = None

    async with httpx.AsyncClient(timeout=30.0) as client:
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}

        for i in range(0, len(huids), chunk_size):
            chunk = huids[i:i + chunk_size]
            payload = {
                "group_chat_id": chat_id,
                "members": [{"user_huid": h} for h in chunk]
            }
            
            chunk_processed = False
            
            # Если рабочий URL уже найден на предыдущей пачке, используем только его.
            # Если нет — перебираем список endpoints.
            urls_to_try = [working_url] if working_url else endpoints
            
            for url in urls_to_try:
                try:
                    resp = await client.post(url, headers=headers, json=payload)
                    
                    # Если ответ НЕ 404 (Page not found) — мы угадали правильный адрес API!
                    if resp.status_code != 404:
                        working_url = url
                        chunk_processed = True
                        
                        if resp.status_code in (200, 201, 204):
                            success_count += len(chunk)
                        else:
                            error_count += len(chunk)
                            # Теперь мы точно увидим, если сервер ругнется на структуру JSON
                            error_details.append(f"HTTP {resp.status_code} ({url}): {resp.text}")
                        break # Прерываем перебор URL и идем к следующей пачке
                except Exception as e:
                    error_details.append(f"Сетевая ошибка к {url}: {e}")
                    
            if not chunk_processed:
                error_count += len(chunk)
                if not error_details:
                    error_details.append("Все эндпоинты вернули 404. Нужна документация Swagger вашего сервера.")
                    
    return success_count, error_count, error_details