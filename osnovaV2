# src/services/express_service.py

import hmac
import hashlib
import httpx
from src.config import settings

async def get_botx_token(bot_id_str: str, cts_url: str) -> str:
    secret_bytes = settings.express.secret_key.encode('utf-8')
    bot_id_bytes = bot_id_str.encode('utf-8')
    signature = hmac.new(secret_bytes, bot_id_bytes, hashlib.sha256).hexdigest().upper()

    async with httpx.AsyncClient() as client:
        token_url = f"{cts_url}/api/v2/botx/bots/{bot_id_str}/token?signature={signature}"
        resp = await client.get(token_url)
        resp.raise_for_status()
        return resp.json().get("result")

async def get_chat_info(bot_id_str: str, cts_url: str, token: str, chat_id_str: str) -> dict:
    async with httpx.AsyncClient() as client:
        info_url = f"{cts_url}/api/v3/botx/chats/info?group_chat_id={chat_id_str}"
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        resp = await client.get(info_url, headers=headers)
        if resp.status_code in (403, 404):
            return {"status": "NOT_FOUND"}
        resp.raise_for_status()

        chat_data = resp.json().get("result", {})
        members = chat_data.get("members", [])

        is_admin = False
        member_huids = set()
        admin_huids = set()

        for m in members:
            huid = str(m.get("user_huid"))
            member_huids.add(huid)
            if m.get("admin", False):
                admin_huids.add(huid)
            if huid == bot_id_str:
                is_admin = m.get("admin", False)

        return {
            "status": "ADMIN" if is_admin else "MEMBER",
            "name": chat_data.get("name", "Неизвестный канал"),
            "member_huids": member_huids,
            "admin_huids": admin_huids
        }

async def get_express_users_dict() -> dict:
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)

    async with httpx.AsyncClient(timeout=60.0) as client:
        csv_url = f"{cts_url}/api/v3/botx/users/users_as_csv"
        headers = {"Authorization": f"Bearer {token}"}
        params = {"cts_user": "true", "unregistered": "false", "botx": "false"}
        resp = await client.get(csv_url, headers=headers, params=params)
        resp.raise_for_status()

        csv_lines = resp.text.strip().split('\n')
        if not csv_lines:
            return {}

        headers = [h.strip().lower() for h in csv_lines[0].split(',')]
        idx_huid = headers.index("huid") if "huid" in headers else 0
        idx_active = headers.index("active") if "active" in headers else 6
        idx_name = headers.index("name") if "name" in headers else 4
        
        idx_mail = -1
        for i, h in enumerate(headers):
            if "mail" in h:
                idx_mail = i
                break
        if idx_mail == -1: idx_mail = 3

        users_dict = {}
        for line in csv_lines[1:]:
            columns = line.split(',')
            if len(columns) > max(idx_huid, idx_active, idx_name, idx_mail):
                email = columns[idx_mail].strip().lower()
                huid = columns[idx_huid].strip()
                active = columns[idx_active].strip().lower() == "true"
                name = columns[idx_name].strip()
                if email and "@" in email:
                    users_dict[email] = {"huid": huid, "active": active, "name": name}
        return users_dict

async def get_express_huids_dict() -> dict:
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)

    async with httpx.AsyncClient(timeout=60.0) as client:
        csv_url = f"{cts_url}/api/v3/botx/users/users_as_csv"
        headers = {"Authorization": f"Bearer {token}"}
        params = {"cts_user": "true", "unregistered": "false", "botx": "false"}
        resp = await client.get(csv_url, headers=headers, params=params)
        resp.raise_for_status()

        csv_lines = resp.text.strip().split('\n')
        if not csv_lines:
            return {}

        headers = [h.strip().lower() for h in csv_lines[0].split(',')]
        idx_huid = headers.index("huid") if "huid" in headers else 0
        idx_active = headers.index("active") if "active" in headers else 6

        huids_dict = {}
        for line in csv_lines[1:]:
            columns = line.split(',')
            if len(columns) > max(idx_huid, idx_active):
                huid = columns[idx_huid].strip()
                active = columns[idx_active].strip().lower() == "true"
                if huid:
                    huids_dict[huid] = active
        return huids_dict

async def add_members_to_chat_batch(chat_id: str, huids: list) -> tuple:
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)
    success_count = 0
    error_count = 0
    error_details = []
    chunk_size = 500

    async with httpx.AsyncClient(timeout=60.0) as client:
        add_url = f"{cts_url}/api/v3/botx/chats/add_user"
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        for i in range(0, len(huids), chunk_size):
            chunk = huids[i:i + chunk_size]
            payload = {"group_chat_id": chat_id, "user_huids": chunk}
            try:
                resp = await client.post(add_url, headers=headers, json=payload)
                if resp.status_code in (200, 201, 204):
                    success_count += len(chunk)
                else:
                    for h in chunk:
                        try:
                            fallback_resp = await client.post(add_url, headers=headers, json={"group_chat_id": chat_id, "user_huids": [h]})
                            if fallback_resp.status_code in (200, 201, 204): success_count += 1
                            else: error_count += 1
                        except Exception: error_count += 1
                    error_details.append(f"HTTP {resp.status_code} для пачки. Запущен Fallback.")
            except Exception as e:
                for h in chunk:
                    try:
                        fallback_resp = await client.post(add_url, headers=headers, json={"group_chat_id": chat_id, "user_huids": [h]})
                        if fallback_resp.status_code in (200, 201, 204): success_count += 1
                        else: error_count += 1
                    except Exception: error_count += 1
                error_details.append(f"Ошибка сети: {str(e)}. Запущен Fallback.")
    return success_count, error_count, error_details

async def remove_members_from_chat_batch(chat_id: str, huids: list) -> tuple:
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)
    success_count = 0
    error_count = 0
    error_details = []
    chunk_size = 100

    async with httpx.AsyncClient(timeout=60.0) as client:
        remove_url = f"{cts_url}/api/v3/botx/chats/remove_user"
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
        for i in range(0, len(huids), chunk_size):
            chunk = huids[i:i + chunk_size]
            payload = {"group_chat_id": chat_id, "user_huids": chunk}
            try:
                resp = await client.post(remove_url, headers=headers, json=payload)
                if resp.status_code == 404:
                    for h in chunk:
                        alt_url = f"{cts_url}/api/v3/botx/chats/{chat_id}/members/{h}"
                        r = await client.delete(alt_url, headers=headers)
                        if r.status_code in (200, 204): success_count += 1
                        else: error_count += 1
                elif resp.status_code in (200, 201, 204):
                    success_count += len(chunk)
                else:
                    error_count += len(chunk)
                    error_details.append(f"HTTP {resp.status_code} для пачки.")
            except Exception as e:
                error_count += len(chunk)
                error_details.append(f"Ошибка сети: {str(e)}")
    return success_count, error_count, error_details