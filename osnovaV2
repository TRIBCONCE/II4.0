@collector.command("/add_by_list", visible=False)
async def add_by_list_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    USER_STATES[user_huid] = {"state": "WAIT_FOR_CHANNEL", "flow": "LIST"}

    await bot.answer_message(
        body="⏳ Формирую базу всех пользователей eXpress для редактирования, это займет пару секунд...")

    try:
        bot_id_str = str(settings.express.uuid)
        cts_url = str(settings.express.cts_url).rstrip("/")
        token = await get_botx_token(bot_id_str, cts_url)

        async with httpx.AsyncClient(timeout=60.0) as client:
            csv_url = f"{cts_url}/api/v3/botx/users/users_as_csv"
            headers = {"Authorization": f"Bearer {token}"}
            params = {"cts_user": "true", "unregistered": "false", "botx": "false"}
            resp = await client.get(csv_url, headers=headers, params=params)
            resp.raise_for_status()
            raw_csv_text = resp.text

        input_file = io.StringIO(raw_csv_text)
        reader = csv.DictReader(input_file, delimiter=',')

        columns_to_drop = [
            "Avatar", "Avatar preview", "Office", "Manager", "Manager HUID",
            "Manager DN", "Description", "Phone", "Other phone", "IP phone",
            "Other IP phone", "Personnel number", "AD Groups"
        ]

        fieldnames = [col for col in reader.fieldnames if col not in columns_to_drop] if reader.fieldnames else []

        output_file = io.StringIO()
        writer = csv.DictWriter(output_file, fieldnames=fieldnames, delimiter=';', extrasaction='ignore')
        writer.writeheader()
        
        for row in reader:
            writer.writerow(row)

        processed_csv_text = output_file.getvalue()
        file_bytes = processed_csv_text.encode('utf-8-sig')

        caption = (
            "Оставьте только нужных пользователей для добавления, а так же не удаляйте заголовки.\n\n"
            "Пришлите мне название целевого канала или группы в формате `##имяканала`.\n"
            "*Обязательно выбери канал из всплывающего синего списка мессенджера!*"
        )

        b64_content = base64.b64encode(file_bytes).decode('utf-8')
        data_uri = f"data:text/csv;base64,{b64_content}"

        class MagicFile:
            def __init__(self, filename, raw_bytes, uri):
                self.filename = self.file_name = self.name = filename
                self.content = raw_bytes
                self.data_uri = self.url = uri

        my_file = MagicFile("express_users_clean.csv", file_bytes, data_uri)

        try:
            await bot.answer_message(body=caption, file=my_file)
        except Exception as pybotx_err:
            await bot.answer_message(f"❌ Последняя ошибка pybotx: {type(pybotx_err).__name__} -> {pybotx_err}")

    except Exception as e:
        await bot.answer_message(f"❌ Критическая ошибка генерации файла: {e}")


@collector.default_message_handler
async def default_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    user_data = USER_STATES.get(user_huid, {})
    current_state = user_data.get("state")
    msg_text = message.body.strip()

    # ─── ШАГ 1: ПОЛУЧЕНИЕ И ПРОВЕРКА КАНАЛА ───
    if current_state == "WAIT_FOR_CHANNEL":
        chat_id = None
        raw_cmd = getattr(message, "raw_command", {})
        if hasattr(raw_cmd, "dict"): raw_cmd = raw_cmd.dict()
        elif not isinstance(raw_cmd, dict): raw_cmd = vars(raw_cmd) if hasattr(raw_cmd, "__dict__") else {}

        for entity in raw_cmd.get("entities", []):
            e_dict = entity.dict() if hasattr(entity, "dict") else (entity if isinstance(entity, dict) else {})
            if e_dict.get("type") == "mention":
                data = e_dict.get("data", {})
                if data.get("mention_type") in ("chat", "channel"):
                    chat_id = data.get("mention_data", {}).get("group_chat_id")
                    break

        if not chat_id:
            await bot.answer_message("Я не вижу канала. Убедись, что используешь `##имя` и выбираешь его из списка!")
            return

        bot_id_str = str(settings.express.uuid)
        cts_url = str(settings.express.cts_url).rstrip("/")
        token = await get_botx_token(bot_id_str, cts_url)

        chat_info = await get_chat_info(bot_id_str, cts_url, token, str(chat_id))
        status = chat_info.get("status")
        chat_name = chat_info.get("name", "Неизвестный канал")

        if status == "ADMIN":
            USER_STATES[user_huid]["target_chat_id"] = str(chat_id)
            USER_STATES[user_huid]["target_chat_name"] = chat_name
            USER_STATES[user_huid]["chat_members"] = chat_info.get("member_huids", set())
            USER_STATES[user_huid]["admin_huids"] = chat_info.get("admin_huids", set())

            flow = user_data.get("flow")

            if flow == "ALL":
                USER_STATES[user_huid]["state"] = "WAIT_FOR_CONFIRMATION_ALL"
                markup = BubbleMarkup()
                markup.add_button(command="/confirm_add_all", label="Да, добавить")
                markup.add_button(command="/cancel_add", label="Нет, отмена")
                await bot.answer_message(body=f"Вы точно готовы добавить **ВСЕХ** активных пользователей в канал **{chat_name}**?", bubbles=markup)
            
            elif flow == "REMOVE":
                USER_STATES[user_huid]["state"] = "WAIT_FOR_CONFIRMATION_REMOVE"
                markup = BubbleMarkup()
                markup.add_button(command="/confirm_remove", label="Да, удалить всех")
                markup.add_button(command="/cancel_add", label="Отмена")
                
                members_count = len(USER_STATES[user_huid]["chat_members"])
                admins_count = len(USER_STATES[user_huid]["admin_huids"])
                to_delete = members_count - admins_count
                
                await bot.answer_message(
                    body=f"Вы точно хотите **УДАЛИТЬ ВСЕХ** обычных пользователей из канала **{chat_name}**?\n\n"
                         f"👥 Всего участников: {members_count}\n"
                         f"🛡 Администраторов: {admins_count}\n\n"
                         f"🗑 Будет удалено: {to_delete} чел.",
                    bubbles=markup
                )
            
            elif flow == "LIST":
                USER_STATES[user_huid]["state"] = "WAIT_FOR_FILE_LIST"
                await bot.answer_message(body=f"✅ Отлично! Я администратор в канале **{chat_name}**.\n\nПожалуйста, загрузи измененный CSV-файл сюда.")
            
            else:
                USER_STATES[user_huid]["state"] = "WAIT_FOR_DEPT"
                await bot.answer_message(body=f"✅ Отлично! Я администратор в канале **{chat_name}**.\n\nВведите часть названия подразделения (например, `сопровожд`):")
        
        elif status == "MEMBER":
            await bot.answer_message(f"⚠️ Я есть в канале **{chat_name}**, но у меня НЕТ прав администратора.")
        else:
            await bot.answer_message(f"❌ Меня нет в канале **{chat_name}**. Добавьте меня и выдайте права администратора.")
        return

    # ─── ШАГ 2: ВВОД СЛОВА ДЛЯ ПОИСКА ПО ПОДРАЗДЕЛЕНИЮ ───
    elif current_state == "WAIT_FOR_DEPT":
        if len(msg_text) < 3:
            await bot.answer_message("Пожалуйста, введите минимум 3 символа для поиска.")
            return

        try:
            ad_results = await search_ad_departments(msg_text)
            if not ad_results:
                await bot.answer_message(f"По запросу «{msg_text}» целевых подразделений не найдено.")
                return

            text_lines = ["**Найдено:**"]
            for dept, count in ad_results.items():
                text_lines.append(f"• {dept} — {count} чел.")
            await bot.answer_message(body="\n".join(text_lines))

            markup = BubbleMarkup()
            for dept, count in ad_results.items():
                markup.add_button(command=f"/select_dept {dept}", label=f"{dept}")

            markup.add_button(command="/cancel_dept", label="Отмена")
            USER_STATES[user_huid]["ad_results"] = ad_results
            USER_STATES[user_huid]["state"] = "WAIT_FOR_DEPT_SELECTION"
            
            await bot.answer_message(body="Выберите нужное подразделение из списка:", bubbles=markup)
        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла ошибка при поиске:**\n`{e}`")
        return

    # ─── ШАГ 3: ОБРАБОТКА НАЖАТИЯ НА КНОПКУ ОТДЕЛА ───
    elif current_state == "WAIT_FOR_DEPT_SELECTION":
        if msg_text == "/cancel_dept":
            USER_STATES[user_huid]["state"] = "WAIT_FOR_DEPT"
            await bot.answer_message(body="Введите часть названия подразделения (например, `сопровожд`):")
            return

        if not msg_text.startswith("/select_dept "):
            await bot.answer_message("Пожалуйста, нажмите на одну из кнопок.")
            return

        dept_name = msg_text.replace("/select_dept ", "").strip()
        dept_count = user_data.get("ad_results", {}).get(dept_name, "?")

        USER_STATES[user_huid]["selected_dept"] = dept_name
        USER_STATES[user_huid]["state"] = "WAIT_FOR_CONFIRMATION_DEPT"

        markup = BubbleMarkup()
        markup.add_button(command="/confirm_add_dept", label="Да, добавить")
        markup.add_button(command="/cancel_add", label="Нет, отмена")

        await bot.answer_message(body=f"Вы точно хотите добавить пользователей подразделения **{dept_name}** ({dept_count} чел.)?", bubbles=markup)
        return

    # ─── ШАГ 4 (А): ПОДТВЕРЖДЕНИЕ И ДОБАВЛЕНИЕ (ПОДРАЗДЕЛЕНИЯ) ───
    elif current_state == "WAIT_FOR_CONFIRMATION_DEPT":
        if msg_text == "/cancel_add":
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="❌ Операция отменена.\n\nВыберите следующее действие:", bubbles=get_main_menu_markup())
            return

        if msg_text != "/confirm_add_dept":
            await bot.answer_message("Пожалуйста, нажмите «Да, добавить» или «Нет, отмена».")
            return

        dept_name = user_data.get("selected_dept")
        chat_id = user_data.get("target_chat_id")
        chat_name = user_data.get("target_chat_name")
        current_members = user_data.get("chat_members", set())

        await bot.answer_message(f"⏳ Сверяю базу и добавляю пользователей в **{chat_name}**...")

        try:
            ad_users = await get_ad_users_by_dept(dept_name)
            express_db = await get_express_users_dict()

            huids_to_add, skipped_users = [], []
            already_in_chat_count = 0

            for ad_u in ad_users:
                email, name = ad_u["email"], ad_u["name"]
                if email in express_db and express_db[email]["active"]:
                    huid = express_db[email]["huid"]
                    if huid in current_members: already_in_chat_count += 1
                    else: huids_to_add.append(huid)
                else:
                    skipped_users.append(name)

            success_add, error_add, error_details = 0, 0, []
            if huids_to_add:
                success_add, error_add, error_details = await add_members_to_chat_batch(chat_id, huids_to_add)

            report = (
                f"Готово. Результат добавления в **{chat_name}**:\n\n"
                f"✅ Успешно добавлено: {success_add}\n"
                f"⚠️ Уже были в канале: {already_in_chat_count}\n"
                f"❌ Ошибки при добавлении: {error_add}\n"
                f"🚫 Пропущено (не в eXpress / неактивные): {len(skipped_users)}\n"
            )

            if error_details:
                err_str = "\n".join(f"• {e}" for e in set(error_details))
                report += f"\n**Детали ошибок API:**\n`{err_str[:1000]}`\n"

            if skipped_users:
                report += "\n**Список пропущенных:**\n" + "\n".join(f"• {u}" for u in skipped_users[:30])
                if len(skipped_users) > 30: report += f"\n*(И еще {len(skipped_users) - 30} сотрудников...)*"

            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body=report)
            await bot.answer_message(body="Выберите следующее действие:", bubbles=get_main_menu_markup())

        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла системная ошибка при добавлении:**\n`{e}`")
        return

    # ─── ШАГ 4 (Б): ПОДТВЕРЖДЕНИЕ И ДОБАВЛЕНИЕ (ВСЕХ АКТИВНЫХ) ───
    elif current_state == "WAIT_FOR_CONFIRMATION_ALL":
        if msg_text == "/cancel_add":
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="❌ Операция отменена.\n\nВыберите следующее действие:", bubbles=get_main_menu_markup())
            return

        if msg_text != "/confirm_add_all":
            await bot.answer_message("Пожалуйста, нажмите «Да, добавить» или «Нет, отмена».")
            return

        chat_id = user_data.get("target_chat_id")
        chat_name = user_data.get("target_chat_name")
        current_members = user_data.get("chat_members", set())

        await bot.answer_message(f"⏳ Получаю список ВСЕХ активных пользователей eXpress и начинаю массовое добавление в **{chat_name}**...\n*(Это может занять некоторое время)*")

        try:
            express_db = await get_express_users_dict()
            huids_to_add = []
            already_in_chat_count = 0

            for email, data in express_db.items():
                if data["active"]:
                    huid = data["huid"]
                    if huid in current_members: already_in_chat_count += 1
                    else: huids_to_add.append(huid)

            success_add, error_add, error_details = 0, 0, []
            if huids_to_add:
                success_add, error_add, error_details = await add_members_to_chat_batch(chat_id, huids_to_add)

            report = (
                f"Готово. Результат массового добавления в **{chat_name}**:\n\n"
                f"✅ Успешно добавлено: {success_add}\n"
                f"⚠️ Уже были в канале: {already_in_chat_count}\n"
                f"❌ Ошибки при добавлении: {error_add}\n"
            )

            if error_details:
                err_str = "\n".join(f"• {e}" for e in set(error_details))
                report += f"\n**Детали ошибок API (работал Fallback):**\n`{err_str[:1000]}`\n"

            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body=report)
            await bot.answer_message(body="Выберите следующее действие:", bubbles=get_main_menu_markup())

        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла системная ошибка при добавлении:**\n`{e}`")
        return

    # ─── ШАГ 4 (В): ПОДТВЕРЖДЕНИЕ И УДАЛЕНИЕ (ВСЕХ КРОМЕ АДМИНОВ) ───
    elif current_state == "WAIT_FOR_CONFIRMATION_REMOVE":
        if msg_text == "/cancel_add":
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="❌ Операция отменена.\n\nВыберите следующее действие:", bubbles=get_main_menu_markup())
            return

        if msg_text != "/confirm_remove":
            await bot.answer_message("Пожалуйста, нажмите «Да, удалить всех» или «Отмена».")
            return

        chat_id = user_data.get("target_chat_id")
        chat_name = user_data.get("target_chat_name")
        current_members = user_data.get("chat_members", set())
        admin_huids = user_data.get("admin_huids", set())

        huids_to_remove = list(current_members - admin_huids)

        if not huids_to_remove:
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="🤷‍♂️ В канале остались только администраторы, удалять некого!")
            await bot.answer_message(body="Выберите следующее действие:", bubbles=get_main_menu_markup())
            return

        await bot.answer_message(f"⏳ Начинаю процесс удаления {len(huids_to_remove)} пользователей из **{chat_name}**...")

        try:
            success_count, error_count, error_details = await remove_members_from_chat_batch(chat_id, huids_to_remove)

            report = (
                f"Готово. Результат очистки канала **{chat_name}**:\n\n"
                f"✅ Успешно удалено: {success_count}\n"
                f"🛡 Оставлено администраторов: {len(admin_huids)}\n"
                f"❌ Ошибки при удалении: {error_count}\n"
            )

            if error_details:
                err_str = "\n".join(f"• {e}" for e in set(error_details))
                report += f"\n**Детали ошибок API:**\n`{err_str[:1000]}`\n"

            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body=report)
            await bot.answer_message(body="Выберите следующее действие:", bubbles=get_main_menu_markup())

        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла системная ошибка при удалении:**\n`{e}`")
        return

    # ─── ШАГ 4 (Г): ЗАГРУЗКА И ВАЛИДАЦИЯ ФАЙЛА (ПО СПИСКУ) ───
    elif current_state == "WAIT_FOR_FILE_LIST":
        if msg_text in ("/cancel_add", "/cancel_dept"):
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="❌ Операция отменена.\n\nВыберите следующее действие:", bubbles=get_main_menu_markup())
            return

        attached_file = getattr(message, 'file', None) or getattr(message, 'document', None)
        if not attached_file:
            await bot.answer_message("Пожалуйста, прикрепите CSV-файл к сообщению.")
            return

        await bot.answer_message("⏳ Читаю файл и сверяю HUID с базой eXpress...")

        try:
            file_data = attached_file.content
            if not file_data:
                await bot.answer_message("❌ Файл пуст или не удалось прочитать его содержимое.")
                return

            if isinstance(file_data, str) and "base64," in file_data:
                file_bytes = base64.b64decode(file_data.split("base64,")[1])
            elif isinstance(file_data, str):
                file_bytes = file_data.encode('utf-8')
            else:
                file_bytes = file_data

            text = ""
            for enc in ['utf-8-sig', 'utf-8', 'cp1251', 'latin1']:
                try:
                    text = file_bytes.decode(enc)
                    break
                except UnicodeDecodeError:
                    continue

            first_line = text.splitlines()[0] if text else ""
            delimiter = ';' if ';' in first_line else ','

            reader = csv.DictReader(io.StringIO(text), delimiter=delimiter)
            huid_col = next((col for col in (reader.fieldnames or []) if col.replace('\ufeff', '').strip().lower() == "huid"), None)

            if not huid_col:
                await bot.answer_message(
                    body=f"❌ В файле не найдена обязательная колонка `huid`.\n\n"
                         f"🔍 **Как бот прочитал заголовки:**\n`{str(reader.fieldnames)}`\n\n"
                         f"📄 **Сырое начало файла:**\n`{repr(text[:200])}`"
                )
                return

            uploaded_huids = {row.get(huid_col).strip() for row in reader if row.get(huid_col)}

            if not uploaded_huids:
                await bot.answer_message("❌ Колонка `huid` пуста.")
                return

            express_huids = await get_express_huids_dict()
            active_huids = [h for h in uploaded_huids if h in express_huids and express_huids[h]]
            inactive_count = len(uploaded_huids) - len(active_huids)

            chat_name = user_data.get("target_chat_name")
            USER_STATES[user_huid]["list_huids_to_add"] = active_huids
            USER_STATES[user_huid]["state"] = "WAIT_FOR_CONFIRMATION_LIST"

            markup = BubbleMarkup()
            markup.add_button(command="/confirm_add_list", label="Да")
            markup.add_button(command="/cancel_add", label="Отмена")

            report = (
                f"Загружено записей: {len(uploaded_huids)}\n"
                f"Активных пользователей: {len(active_huids)}\n"
                f"Неактивных (будут пропущены): {inactive_count}\n\n"
                f"Добавить {len(active_huids)} пользователей в **{chat_name}**?"
            )
            await bot.answer_message(body=report, bubbles=markup)

        except Exception as e:
            await bot.answer_message(body=f"❌ **Ошибка при обработке файла:**\n`{e}`")
        return

    # ─── ШАГ 4 (Д): ПОДТВЕРЖДЕНИЕ И ДОБАВЛЕНИЕ (ПО СПИСКУ) ───
    elif current_state == "WAIT_FOR_CONFIRMATION_LIST":
        if msg_text == "/cancel_add":
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="❌ Операция отменена.\n\nВыберите следующее действие:", bubbles=get_main_menu_markup())
            return

        if msg_text != "/confirm_add_list":
            await bot.answer_message("Пожалуйста, нажмите «Да» или «Отмена».")
            return

        chat_id = user_data.get("target_chat_id")
        chat_name = user_data.get("target_chat_name")
        current_members = user_data.get("chat_members", set())
        active_huids_from_file = user_data.get("list_huids_to_add", [])

        await bot.answer_message(f"⏳ Начинаю добавление пользователей из списка в канал **{chat_name}**...")

        try:
            huids_to_add = [h for h in active_huids_from_file if h not in current_members]
            already_in_chat_count = len(active_huids_from_file) - len(huids_to_add)

            success_add, error_add, error_details = 0, 0, []
            if huids_to_add:
                success_add, error_add, error_details = await add_members_to_chat_batch(chat_id, huids_to_add)

            report = (
                f"Готово. Результат добавления по списку в **{chat_name}**:\n\n"
                f"✅ Успешно добавлено: {success_add}\n"
                f"⚠️ Уже были в канале: {already_in_chat_count}\n"
                f"❌ Ошибки при добавлении: {error_add}\n"
            )

            if error_details:
                err_str = "\n".join(f"• {e}" for e in set(error_details))
                report += f"\n**Детали ошибок API (работал Fallback):**\n`{err_str[:1000]}`\n"

            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body=report)
            await bot.answer_message(body="Выберите следующее действие:", bubbles=get_main_menu_markup())

        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла системная ошибка при добавлении:**\n`{e}`")
        return

    # ─── ЕСЛИ СОСТОЯНИЯ НЕТ ───
    USER_STATES[user_huid] = {"state": "WAIT_FOR_ACTION"}
    await bot.answer_message(
        body="Привет! Я бот для массового добавления и удаления пользователей.\n\nВыберите действие:",
        bubbles=get_main_menu_markup()
    )