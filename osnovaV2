@collector.command("/add_by_list", visible=False)
async def add_by_list_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    USER_STATES[user_huid] = {"state": "WAIT_FOR_CHANNEL", "flow": "LIST"}
    
    await bot.answer_message(body="⏳ Формирую базу всех пользователей eXpress для редактирования, это займет пару секунд...")
    
    try:
        bot_id_str = str(settings.express.uuid)
        cts_url = str(settings.express.cts_url).rstrip("/")
        token = await get_botx_token(bot_id_str, cts_url)

        # Скачиваем список пользователей
        async with httpx.AsyncClient(timeout=60.0) as client:
            csv_url = f"{cts_url}/api/v3/botx/users/users_as_csv"
            headers = {"Authorization": f"Bearer {token}"}
            params = {"cts_user": "true", "unregistered": "false", "botx": "false"}
            resp = await client.get(csv_url, headers=headers, params=params)
            resp.raise_for_status()
            csv_text = resp.text

        file_bytes = csv_text.encode('utf-8-sig')

        caption = (
            "Оставьте только нужных пользователей для добавления, а так же не удаляйте заголовки.\n\n"
            "После того как файл будет готов, пришли мне название целевого канала или группы в формате `##имяканала`.\n"
            "*Обязательно выбери канал из всплывающего синего списка мессенджера!*"
        )

        import base64
        import uuid
        
        b64_content = base64.b64encode(file_bytes).decode('utf-8')
        data_uri = f"data:text/csv;base64,{b64_content}"
        
        # Наш "сырой" файл в формате Data URI (поддерживается eXpress нативно)
        raw_attachment = {
            "type": "document",
            "data": {
                "file_name": "express_users.csv",
                "content": data_uri
            }
        }
        
        # Добываем ID чата из сообщения
        raw_cmd = getattr(message, "raw_command", {})
        if hasattr(raw_cmd, "dict"): raw_cmd = raw_cmd.dict()
        elif not isinstance(raw_cmd, dict): raw_cmd = vars(raw_cmd) if hasattr(raw_cmd, "__dict__") else {}
        chat_id_str = raw_cmd.get("from", {}).get("group_chat_id")

        if not chat_id_str:
            await bot.answer_message(body="❌ Не удалось определить чат для отправки файла.")
            return

        chat_uuid = uuid.UUID(chat_id_str)
        bot_uuid = settings.express.uuid

        # 🚀 УМНЫЙ ПЕРЕБОР: Пробуем ВСЕ возможные комбинации, которые когда-либо существовали в pybotx
        attempts = [
            # Варианты для bot.answer_message (без bot_id)
            (bot.answer_message, {"body": caption, "file": raw_attachment}),
            (bot.answer_message, {"body": caption, "document": raw_attachment}),
            (bot.answer_message, {"body": caption, "attachments": [raw_attachment]}),
            
            # Варианты для bot.send_message (с bot_id как UUID)
            (bot.send_message, {"bot_id": bot_uuid, "chat_id": chat_uuid, "body": caption, "file": raw_attachment}),
            (bot.send_message, {"bot_id": bot_uuid, "chat_id": chat_uuid, "body": caption, "document": raw_attachment}),
            (bot.send_message, {"bot_id": bot_uuid, "chat_id": chat_uuid, "body": caption, "attachments": [raw_attachment]}),
            (bot.send_message, {"bot_id": bot_uuid, "group_chat_id": chat_uuid, "body": caption, "file": raw_attachment}),
            
            # Варианты для bot.send_message (с bot_id как строкой, на случай старых версий)
            (bot.send_message, {"bot_id": bot_id_str, "chat_id": chat_id_str, "body": caption, "file": raw_attachment}),
            (bot.send_message, {"bot_id": bot_id_str, "chat_id": chat_id_str, "body": caption, "attachments": [raw_attachment]}),
        ]

        success = False
        errors = []

        for method, kwargs in attempts:
            try:
                await method(**kwargs)
                success = True
                break  # Как только одна комбинация сработала - прерываем цикл!
            except TypeError as e:
                # Ошибки несовпадения аргументов (пропускаем и пробуем следующую комбинацию)
                if "unexpected keyword argument" in str(e) or "missing" in str(e):
                    errors.append(f"{method.__name__}({list(kwargs.keys())}): {e}")
                else:
                    # Ошибки валидации типов от Pydantic
                    errors.append(f"{method.__name__}({list(kwargs.keys())}): Type/Pydantic Error -> {e}")
            except Exception as e:
                # Другие системные ошибки
                errors.append(f"{method.__name__}({list(kwargs.keys())}): {type(e).__name__} -> {e}")

        # Если ни один из вариантов не подошел, вываливаем красивый лог
        if not success:
            debug_info = "\n".join(errors)
            await bot.answer_message(body=f"❌ Все варианты отправки отклонены библиотекой.\n`{debug_info[:3000]}`")

    except Exception as e:
        await bot.answer_message(f"❌ Критическая ошибка генерации файла: {e}")