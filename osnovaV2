    user_huid = str(message.sender.huid)
    USER_STATES[user_huid] = {"state": "WAIT_FOR_CHANNEL"}

    await bot.answer_message(
        body="Привет! Я бот для массового добавления пользователей.\n\n"
             "Пришли мне название целевого канала или группы в формате `##имяканала`.\n"
             "*Обязательно выбери канал из всплывающего синего списка мессенджера!*"
    )


@collector.command("/add_by_dept", visible=False)
async def add_by_dept_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    user_data = USER_STATES.get(user_huid, {})

    if user_data.get("state") != "WAIT_FOR_ACTION":
        await bot.answer_message("Сначала выберите канал с помощью команды /start.")
        return

    USER_STATES[user_huid]["state"] = "WAIT_FOR_DEPT"
    await bot.answer_message(body="Введите часть названия подразделения (например, `сопровожд`):")


@collector.default_message_handler
async def default_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    user_data = USER_STATES.get(user_huid, {})
    current_state = user_data.get("state")

    # ─── ШАГ 1: ПОЛУЧЕНИЕ КАНАЛА ───
    if current_state == "WAIT_FOR_CHANNEL":
        chat_id = None
        chat_name = "Неизвестный канал"
        raw_cmd = getattr(message, "raw_command", {})
        if hasattr(raw_cmd, "dict"): raw_cmd = raw_cmd.dict()
        elif not isinstance(raw_cmd, dict): raw_cmd = vars(raw_cmd) if hasattr(raw_cmd, "__dict__") else {}

        for entity in raw_cmd.get("entities", []):
            e_dict = entity.dict() if hasattr(entity, "dict") else (entity if isinstance(entity, dict) else {})
            if e_dict.get("type") == "mention":
                data = e_dict.get("data", {})
                if data.get("mention_type") in ("chat", "channel"):
                    chat_id = data.get("mention_data", {}).get("group_chat_id")
                    chat_name = data.get("mention_data", {}).get("name", chat_name)
                    break

        if not chat_id:
            await bot.answer_message("Я не вижу канала. Убедись, что используешь `##имя` и выбираешь его из списка!")
            return

        await bot.answer_message(body=f"⏳ Проверяю права в канале **{chat_name}**...")
        status = await check_bot_admin_rights(bot, str(chat_id), chat_name)

        if status == "ADMIN":
            USER_STATES[user_huid]["target_chat_id"] = str(chat_id)
            USER_STATES[user_huid]["target_chat_name"] = chat_name
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            markup = BubbleMarkup()
            markup.add_button(command="/add_by_dept", label="Добавить по подразделению")
            await bot.answer_message(body=f"✅ Отлично! Я администратор в канале **{chat_name}**.\n\nЧто будем делать дальше?", bubbles=markup)
        elif status == "MEMBER":
            await bot.answer_message(f"⚠️ Я есть в канале **{chat_name}**, но у меня НЕТ прав администратора.")
        else:
            await bot.answer_message(f"❌ Меня нет в канале **{chat_name}**. Добавьте меня и выдайте права администратора.")
        return

    # ─── ШАГ 2: ВВОД СЛОВА ДЛЯ ПОИСКА ───
    elif current_state == "WAIT_FOR_DEPT":
        search_str = message.body.strip()
        if len(search_str) < 3:
            await bot.answer_message("Пожалуйста, введите минимум 3 символа для поиска.")
            return

        await bot.answer_message(f"⏳ Выполняю поиск в Active Directory по запросу «{search_str}»...")

        try:
            ad_results = await search_ad_departments(search_str)
            if not ad_results:
                await bot.answer_message(f"По запросу «{search_str}» целевых подразделений не найдено.")
                return

            # Формируем кнопки вместо текста!
            markup = BubbleMarkup()
            for dept, count in ad_results.items():
                # Мы передаем название отдела скрытой командой, которую бот поймает на следующем шаге
                markup.add_button(command=f"/select_dept {dept}", label=f"{dept} — {count} чел.")

            # Переключаем состояние на ожидание нажатия кнопки
            USER_STATES[user_huid]["state"] = "WAIT_FOR_DEPT_SELECTION"
            
            await bot.answer_message(
                body="**Найдено:**\nВыберите нужное подразделение из списка:",
                bubbles=markup
            )
        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла ошибка при поиске:**\n`{e}`")
        return

    # ─── ШАГ 3: ОБРАБОТКА НАЖАТИЯ НА КНОПКУ ОТДЕЛА ───
    elif current_state == "WAIT_FOR_DEPT_SELECTION":
        if not message.body.startswith("/select_dept "):
            await bot.answer_message("Пожалуйста, нажмите на одну из кнопок подразделений.")
            return
            
        # Достаем точное название отдела из скрытой команды кнопки
        dept_name = message.body.replace("/select_dept ", "").strip()
        
        await bot.answer_message(f"⏳ Собираю сотрудников из подразделения **{dept_name}** и сверяю их почты с базой Express...")

        try:
            # 1. Достаем почты сотрудников этого отдела из AD
            ad_emails = await get_ad_users_by_dept(dept_name)
            
            if not ad_emails:
                await bot.answer_message(f"В подразделении **{dept_name}** нет сотрудников с заполненной почтой в Active Directory.")
                return

            # 2. Скачиваем базу Express и собираем все активные почты
            express_emails = await get_express_active_emails()
            
            # 3. Находим совпадения (пересечение)
            matched_emails = []
            for mail in ad_emails:
                if mail in express_emails:
                    matched_emails.append(mail)

            if not matched_emails:
                await bot.answer_message("Ни один сотрудник из этого подразделения не найден в Express (совпадений по email нет).")
                return

            # 4. Формируем финальный красивый вывод
            email_list_str = "\n".join(f"• {e}" for e in matched_emails)
            await bot.answer_message(
                body=f"✅ **Всё прошло отлично!**\nСотрудники подразделения **{dept_name}** ({len(matched_emails)} чел.) успешно найдены в Express:\n\n{email_list_str}"
            )
            
            # Сохраняем найденный список почт в FSM на будущее (пригодится для функции добавления)
            USER_STATES[user_huid]["matched_emails"] = matched_emails
            
        except Exception as e:
            await bot.answer_message(body=f"❌ **Произошла ошибка при сверке пользователей:**\n`{e}`")
        return

    # ─── ЕСЛИ СОСТОЯНИЯ НЕТ ───
    await bot.answer_message(body="Введите `/start`, чтобы начать работу с ботом.")