async def add_members_to_chat_batch(chat_id: str, huids: list) -> tuple:
    """Добавляет пользователей пачками по 500 через проверенный эндпоинт add_user."""
    bot_id_str = str(settings.express.uuid)
    cts_url = str(settings.express.cts_url).rstrip("/")
    token = await get_botx_token(bot_id_str, cts_url)
    
    success_count = 0
    error_count = 0
    error_details = []
    chunk_size = 500

    async with httpx.AsyncClient(timeout=30.0) as client:
        # Тот самый 100% рабочий эндпоинт из твоего примера
        add_url = f"{cts_url}/api/v3/botx/chats/add_user"
        headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}

        for i in range(0, len(huids), chunk_size):
            chunk = huids[i:i + chunk_size]
            
            # Строго тот payload, который ты прислал: плоский список строк
            payload = {
                "group_chat_id": chat_id,
                "user_huids": chunk
            }
            
            try:
                resp = await client.post(add_url, headers=headers, json=payload)
                
                # Коды 200 (OK), 201 (Created), 204 (No Content) считаем успехом
                if resp.status_code in (200, 201, 204):
                    success_count += len(chunk)
                else:
                    error_count += len(chunk)
                    error_details.append(f"HTTP {resp.status_code}: {resp.text}")
            except Exception as e:
                error_count += len(chunk)
                error_details.append(f"Ошибка сети: {str(e)}")
                
    return success_count, error_count, error_details