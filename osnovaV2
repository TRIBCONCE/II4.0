@collector.command("/my_access", visible=False)
async def my_access_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    if not await check_auth(user_huid, bot): return

    # Вытаскиваем AD логин и ФИО напрямую из сырых данных eXpress профиля
    raw_cmd = getattr(message, "raw_command", {})
    if hasattr(raw_cmd, "dict"): raw_cmd = raw_cmd.dict()
    elif not isinstance(raw_cmd, dict): raw_cmd = vars(raw_cmd) if hasattr(raw_cmd, "__dict__") else {}

    sender_info = raw_cmd.get("from", {})
    ad_login = sender_info.get("ad_login")
    username = sender_info.get("username", "Пользователь")

    if not ad_login:
        await bot.answer_message("❌ Ваш корпоративный логин (AD Login) не привязан к профилю eXpress.")
        return

    await bot.answer_message("⏳ Получаю данные из Active Directory...")

    try:
        # Запрашиваем группы через наш новый сервис
        groups = await get_user_ad_groups(ad_login)

        if not groups:
            await bot.answer_message(
                body=f"У пользователя **{username}** нет дополнительных доступов в AD.",
                bubbles=get_main_menu_markup()
            )
            return

        # Формируем красивый отчет
        report_lines = [f"Список доступов пользователя **{username}**:"]
        for g in groups:
            report_lines.append(f"• {g}")

        report_text = "\n".join(report_lines)

        # Защита от слишком длинного сообщения (лимиты мессенджера)
        if len(report_text) > 4000:
            report_text = report_text[:4000] + "\n\n*(...список обрезан из-за превышения лимита символов)*"

        USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"

        await bot.answer_message(body=report_text)
        await bot.answer_message(body="Выберите следующее действие:", bubbles=get_main_menu_markup())

    except Exception as e:
        await bot.answer_message(f"❌ **Системная ошибка при запросе в AD:**\n`{e}`")