# 🌟 ─── ШАГ: ЗАПРОС СПИСКА ГРУППЫ (ВВОД ИМЕНИ И ГЕНЕРАЦИЯ EXCEL) ─── 🌟
    elif current_state == "WAIT_FOR_GROUP_NAME":
        if msg_text == "/group_choice_no":
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(body="Действие отменено.", bubbles=get_main_menu_markup())
            return
            
        group_name = msg_text.strip()
        user_groups = user_data.get("ad_groups", [])
        
        matched_group = next((g for g in user_groups if g.lower() == group_name.lower()), None)
        
        if not matched_group:
            markup = BubbleMarkup()
            markup.add_button(command="/group_choice_no", label="Отмена")
            await bot.answer_message(
                body="❌ У вас нет доступа к такой группе. Проверьте правильность написания и попробуйте еще раз:", 
                bubbles=markup
            )
            return
            
        await bot.answer_message(f"⏳ Собираю участников группы **{matched_group}**, формирую Excel-файл...")
        
        try:
            members = await get_ad_group_members(matched_group)
            
            if not members:
                USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
                await bot.answer_message("В этой группе пока нет пользователей.", bubbles=get_main_menu_markup())
                return
            
            # 🌟 МАГИЯ EXCEL С АВТОШИРИНОЙ 🌟
            import openpyxl
            from openpyxl.utils import get_column_letter
            import io
            import base64
            
            wb = openpyxl.Workbook()
            ws = wb.active
            ws.title = "Участники группы"
            
            # Заголовки с нужным порядком
            headers = [
                "ФИО", "Логин", "Должность", "Статус", "Почта", "Блок", 
                "Ext Атрибут 1", "Ext Атрибут 2", "Ext Атрибут 3", 
                "Ext Атрибут 4", "Ext Атрибут 5", "Ext Атрибут 6"
            ]
            ws.append(headers)
            
            # Заполняем строки
            for m in members:
                ws.append([
                    m["name"], m["login"], m["title"], m["status"], m["mail"], m["block"],
                    m["ext1"], m["ext2"], m["ext3"], m["ext4"], m["ext5"], m["ext6"]
                ])
                
            # Проходимся по всем колонкам и устанавливаем ширину по самому длинному тексту
            for col in ws.columns:
                max_length = 0
                column_letter = get_column_letter(col[0].column)
                for cell in col:
                    if cell.value:
                        if len(str(cell.value)) > max_length:
                            max_length = len(str(cell.value))
                # Добавляем небольшой отступ (+2) для красоты
                ws.column_dimensions[column_letter].width = max_length + 2
            
            # Сохраняем книгу в память
            output_file = io.BytesIO()
            wb.save(output_file)
            xlsx_bytes = output_file.getvalue()
            
            # Кодируем для отправки
            b64_content = base64.b64encode(xlsx_bytes).decode('utf-8')
            mime_type = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            data_uri = f"data:{mime_type};base64,{b64_content}"

            class MagicFile:
                def __init__(self, filename, raw_bytes, uri):
                    self.filename = self.file_name = self.name = filename
                    self.content = raw_bytes
                    self.data_uri = self.url = uri

            safe_group_filename = "".join(c for c in matched_group if c.isalnum() or c in " -_").strip()
            my_file = MagicFile(f"users_{safe_group_filename}.xlsx", xlsx_bytes, data_uri)

            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(
                body=f"✅ Готово! Найдено {len(members)} участников.\n\nВыберите следующее действие:", 
                file=my_file,
                bubbles=get_main_menu_markup()
            )
            
        except Exception as e:
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(f"❌ Ошибка выгрузки группы: {e}", bubbles=get_main_menu_markup())

        return
