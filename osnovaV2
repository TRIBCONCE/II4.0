# ─── ШАГ 4 (В): ЗАГРУЗКА И ВАЛИДАЦИЯ ФАЙЛА (ПО СПИСКУ) ───
    elif current_state == "WAIT_FOR_FILE_LIST":
        if msg_text in ("/cancel_add", "/cancel_dept"):
            USER_STATES[user_huid]["state"] = "WAIT_FOR_ACTION"
            await bot.answer_message(
                body="❌ Операция отменена.\n\nВыберите следующее действие:",
                bubbles=get_main_menu_markup()
            )
            return

        attached_file = getattr(message, 'file', None) or getattr(message, 'document', None)
        if not attached_file:
            await bot.answer_message("Пожалуйста, прикрепите CSV-файл к сообщению.")
            return

        await bot.answer_message("⏳ Читаю файл и сверяю HUID с базой eXpress...")

        try:
            file_data = attached_file.content
            
            if not file_data:
                await bot.answer_message("❌ Файл пуст или не удалось прочитать его содержимое.")
                return

            # Безопасное извлечение байтов
            import base64
            if isinstance(file_data, str) and "base64," in file_data:
                b64_str = file_data.split("base64,")[1]
                file_bytes = base64.b64decode(b64_str)
            elif isinstance(file_data, str):
                file_bytes = file_data.encode('utf-8')
            else:
                file_bytes = file_data

            # Бронебойная раскодировка: перебираем все возможные варианты от Excel
            text = ""
            for enc in ['utf-8-sig', 'utf-8', 'cp1251', 'latin1']:
                try:
                    text = file_bytes.decode(enc)
                    break
                except UnicodeDecodeError:
                    continue

            # Определяем разделитель по первой строке
            first_line = text.splitlines()[0] if text else ""
            delimiter = ';' if ';' in first_line else ','
            
            import csv
            import io
            reader = csv.DictReader(io.StringIO(text), delimiter=delimiter)

            # Ищем колонку huid, игнорируя регистр, пробелы и невидимые символы (BOM)
            huid_col = None
            if reader.fieldnames:
                for col in reader.fieldnames:
                    # Очищаем от мусора
                    clean_col = col.replace('\ufeff', '').strip().lower()
                    if clean_col == "huid":
                        huid_col = col  # Запоминаем оригинальное название колонки
                        break

            if not huid_col:
                # Если не нашли — делаем "рентген" файла и выводим в чат!
                debug_fields = str(reader.fieldnames)
                debug_text = repr(text[:200])  # Берем первые 200 символов
                await bot.answer_message(
                    body=f"❌ В файле не найдена обязательная колонка `huid`.\n\n"
                         f"🔍 **Как бот прочитал заголовки:**\n`{debug_fields}`\n\n"
                         f"📄 **Сырое начало файла:**\n`{debug_text}`\n\n"
                         f"Пожалуйста, пришлите этот вывод мне, чтобы мы нашли ошибку формата!"
                )
                return
            
            uploaded_huids = set()
            for row in reader:
                h = row.get(huid_col)
                if h:
                    uploaded_huids.add(h.strip())

            if not uploaded_huids:
                await bot.answer_message("❌ Колонка `huid` пуста.")
                return

            express_huids = await get_express_huids_dict()

            active_huids = []
            inactive_count = 0

            for h in uploaded_huids:
                if h in express_huids and express_huids[h]:
                    active_huids.append(h)
                else:
                    inactive_count += 1

            chat_name = user_data.get("target_chat_name")
            USER_STATES[user_huid]["list_huids_to_add"] = active_huids
            USER_STATES[user_huid]["state"] = "WAIT_FOR_CONFIRMATION_LIST"

            markup = BubbleMarkup()
            markup.add_button(command="/confirm_add_list", label="Да")
            markup.add_button(command="/cancel_add", label="Отмена")

            report = (
                f"Загружено записей: {len(uploaded_huids)}\n"
                f"Активных пользователей: {len(active_huids)}\n"
                f"Неактивных (будут пропущены): {inactive_count}\n\n"
                f"Добавить {len(active_huids)} пользователей в **{chat_name}**?"
            )

            await bot.answer_message(body=report, bubbles=markup)

        except Exception as e:
            await bot.answer_message(body=f"❌ **Ошибка при обработке файла:**\n`{e}`")

        return