@collector.command("/add_by_list", visible=False)
async def add_by_list_handler(message: IncomingMessage, bot: Bot) -> None:
    user_huid = str(message.sender.huid)
    USER_STATES[user_huid] = {"state": "WAIT_FOR_CHANNEL", "flow": "LIST"}
    
    await bot.answer_message(body="⏳ Формирую базу всех пользователей eXpress для редактирования, это займет пару секунд...")
    
    try:
        bot_id_str = str(settings.express.uuid)
        cts_url = str(settings.express.cts_url).rstrip("/")
        token = await get_botx_token(bot_id_str, cts_url)

        # 1. Скачиваем список всех пользователей
        async with httpx.AsyncClient(timeout=60.0) as client:
            csv_url = f"{cts_url}/api/v3/botx/users/users_as_csv"
            headers = {"Authorization": f"Bearer {token}"}
            params = {"cts_user": "true", "unregistered": "false", "botx": "false"}
            resp = await client.get(csv_url, headers=headers, params=params)
            resp.raise_for_status()
            csv_text = resp.text

        file_bytes = csv_text.encode('utf-8-sig')

        caption = (
            "Оставьте только нужных пользователей для добавления, а так же не удаляйте заголовки.\n\n"
            "После того как файл будет готов, пришли мне название целевого канала или группы в формате `##имяканала`.\n"
            "*Обязательно выбери канал из всплывающего синего списка мессенджера!*"
        )

        import base64
        import uuid
        b64_content = base64.b64encode(file_bytes).decode('utf-8')
        data_uri = f"data:text/csv;base64,{b64_content}"
        
        raw_attachment = {
            "type": "document",
            "data": {
                "file_name": "express_users.csv",
                "content": data_uri
            }
        }
        
        # Получаем ID чата для отправки (твоя личка с ботом)
        raw_cmd = getattr(message, "raw_command", {})
        if hasattr(raw_cmd, "dict"): raw_cmd = raw_cmd.dict()
        elif not isinstance(raw_cmd, dict): raw_cmd = vars(raw_cmd) if hasattr(raw_cmd, "__dict__") else {}
        chat_id = raw_cmd.get("from", {}).get("group_chat_id")

        if not chat_id:
            await bot.answer_message(body="❌ Не удалось определить чат для отправки файла.")
            return

        success = False
        errors = []
        
        # 🚀 ПОПЫТКА 1: Используем внутренний метод send_message
        bot_client = getattr(bot, 'client', None) or getattr(bot, '_client', None) or getattr(bot, 'botx_client', None)
        targets = [bot, bot_client]
        
        for t in targets:
            if not t: continue
            if hasattr(t, 'send_message'):
                try:
                    await t.send_message(group_chat_id=chat_id, body=caption, attachments=[raw_attachment])
                    success = True
                    break
                except Exception as e:
                    errors.append(f"bot_api_err: {e}")

        # 🚀 ПОПЫТКА 2: Если метода нет, отправляем запрос в правильный BotX API (не в CTS!)
        if not success:
            botx_api = getattr(settings.express, 'botx_api', None) or getattr(settings.express, 'botx_url', None)
            
            if botx_api:
                botx_api = str(botx_api).rstrip("/")
                payload = {
                    "bot_id": bot_id_str,
                    "events": [{
                        "sync_id": str(uuid.uuid4()),
                        "type": "command",
                        "group_chat_id": chat_id,
                        "command": {"body": caption, "command_type": "user"},
                        "attachments": [raw_attachment]
                    }]
                }
                async with httpx.AsyncClient(timeout=30.0) as http:
                    headers_api = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
                    for ver in ["v3", "v2", "v4"]:
                        url = f"{botx_api}/api/{ver}/botx/events"
                        try:
                            r = await http.post(url, headers=headers_api, json=payload)
                            if r.status_code not in (404, 405):
                                r.raise_for_status()
                                success = True
                                break
                            errors.append(f"HTTP {r.status_code} at {url}")
                        except Exception as e:
                            errors.append(f"HTTP_req_err {url}: {e}")
            else:
                errors.append("В настройках settings.express не найден URL botx_api")

        # 🔍 ЕСЛИ ВСЕ УПАЛО: Выводим системную отладку
        if not success:
            s_dict = {k: v for k, v in settings.express.dict().items() if 'secret' not in k.lower()}
            debug_msg = (
                f"❌ Не удалось отправить файл.\n"
                f"Ошибки: {errors}\n\n"
                f"Настройки: {s_dict}\n"
                f"Методы бота: {[m for m in dir(bot) if 'message' in m or 'file' in m]}"
            )
            await bot.answer_message(body=debug_msg[:3000])

    except Exception as e:
        await bot.answer_message(f"❌ Критическая ошибка генерации файла: {e}")